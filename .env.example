# Optional environment variables

# Dev server port (default: 3002, set in .env.defaults)
# PORT=3002

# The address people use to reach this editor. Read per request; set it when
# Pascal is hosted outside localhost (Mint sign-in and agent links use it).
# PASCAL_PUBLIC_URL=https://pascal.example.com

# Self-hosting: the one password that unlocks this editor. Required on any host
# that is not loopback. See SETUP.md, "Self-hosting".
# PASCAL_ADMIN_PASSWORD=change-me

# Optional bearer token for agents and scripts calling /api/scenes.
# PASCAL_SCENE_API_TOKEN=change-me-too

# CRM (crm_donà): indirizzo e chiave pubblica (publishable/anon) di Supabase.
# Servono per leggere il catalogo e, dalla fase 4, inviare la distinta.
# NEXT_PUBLIC_CRM_SUPABASE_URL=https://<progetto>.supabase.co
# NEXT_PUBLIC_CRM_SUPABASE_KEY=sb_publishable_...
